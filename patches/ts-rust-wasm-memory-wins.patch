diff --git a/crates/ts_goport/parts/goport_util/build.rs b/crates/ts_goport/parts/goport_util/build.rs
index 0ad6b29b..b7ac9556 100644
--- a/crates/ts_goport/parts/goport_util/build.rs
+++ b/crates/ts_goport/parts/goport_util/build.rs
@@ -1,11 +1,13 @@
 //! The wasm build packs the bundled libs and the diagnostic message texts.
 //! For a wasm target, this writes:
-//! - the `crates/ts_goport/libs/lib.*.d.ts` files (not with `noembed`) as one
-//!   LZMA stream to `OUT_DIR/libs.lzma`, and their paths and sizes in stream
-//!   order to `OUT_DIR/libs.rs`. `src/frontend/bundled/embed.rs` unpacks the
-//!   stream up to the last lib that a run reads. One stream is 0.31 MB, where
-//!   one stream per lib was 0.48 MB: lib.webworker.d.ts repeats much of
-//!   lib.dom.d.ts.
+//! - the `crates/ts_goport/libs/lib.*.d.ts` files (not with `noembed`) as two
+//!   LZMA streams to `OUT_DIR/libs-0.lzma` and `OUT_DIR/libs-1.lzma`, and
+//!   their paths, sizes and streams in stream order to `OUT_DIR/libs.rs`.
+//!   `src/frontend/bundled/embed.rs` unpacks a stream up to the last lib that
+//!   a run reads from it. Stream 0 has the libs that do not describe the web
+//!   (0.65 MB of text, a 1 MiB window); stream 1 has the dom and webworker
+//!   libs (3.1 MB, a 4 MiB window), so lib.webworker.d.ts still shares a
+//!   stream with lib.dom.d.ts, whose text it repeats.
 //! - the texts of `src/diagnostics/catalog.rs`, in catalog order and ended
 //!   by NUL, as one LZMA stream to `OUT_DIR/diagnostic_texts.lzma`.
 //!   `src/diagnostics/mod.rs` unpacks it on the first text read: 44 KB, not
@@ -32,9 +34,12 @@ fn main() {
     pack_libs();
 }
 
-/// Packs the libs into one stream. The webworker libs come last, so a run
-/// that reads none of them (most do not) unpacks 3.0 of the 3.79 MB. Most
-/// programs read lib.dom.d.ts and nearly all the other libs.
+/// Packs the libs into two streams (see the crate comment). A run that
+/// reads no dom or webworker lib (`"lib": ["es2022"]`) unpacks only stream
+/// 0: 0.65 MB of text and a 1 MiB window, where one stream in name order
+/// unpacked lib.dom.d.ts (2.35 MB) too and kept a 4 MiB window. In stream 1
+/// the webworker libs come last, so a run that reads lib.dom.d.ts and none
+/// of them (most do not) unpacks 2.35 of the 3.1 MB.
 fn pack_libs() {
     let libs = PathBuf::from(env("CARGO_MANIFEST_DIR")).join("../../libs");
     println!("cargo:rerun-if-changed={}", libs.display());
@@ -44,22 +49,41 @@ fn pack_libs() {
         .filter_map(|name| name.into_string().ok())
         .filter(|name| name.starts_with("lib.") && name.ends_with(".d.ts"))
         .collect();
-    let webworker = |name: &str| {
-        name.starts_with("lib.webworker.") && name != "lib.webworker.importscripts.d.ts"
+    // 0: not web, 1: dom, 2: webworker. Groups 1 and 2 share stream 1.
+    let group = |name: &str| {
+        if name.starts_with("lib.dom.") {
+            1
+        } else if name.starts_with("lib.webworker.") && name != "lib.webworker.importscripts.d.ts" {
+            2
+        } else {
+            0
+        }
     };
-    names.sort_by(|a, b| (webworker(a), a).cmp(&(webworker(b), b)));
-    let mut texts = Vec::new();
-    let mut index = String::from("static PACKED_LIBS: &[(&str, usize)] = &[\n");
+    names.sort_by(|a, b| (group(a), a).cmp(&(group(b), b)));
+    let mut texts = [Vec::new(), Vec::new()];
+    let mut index = String::from("static PACKED_LIBS: &[(&str, usize, usize)] = &[\n");
     for name in &names {
         let path = libs.join(name);
         println!("cargo:rerun-if-changed={}", path.display());
         let text = std::fs::read(path).expect("read a lib");
-        writeln!(index, "    (\"libs/{name}\", {}),", text.len()).expect("write to a String");
-        texts.extend_from_slice(&text);
+        let stream = usize::from(group(name) > 0);
+        writeln!(index, "    (\"libs/{name}\", {}, {stream}),", text.len())
+            .expect("write to a String");
+        texts[stream].extend_from_slice(&text);
     }
     index.push_str("];\n");
+    index.push_str("static PACKED_STREAMS: [&[u8]; 2] = [\n");
     let out = PathBuf::from(env("OUT_DIR"));
-    std::fs::write(out.join("libs.lzma"), pack(&texts)).expect("write the libs");
+    for (stream, text) in texts.iter().enumerate() {
+        let file = format!("libs-{stream}.lzma");
+        std::fs::write(out.join(&file), pack(text)).expect("write the libs");
+        writeln!(
+            index,
+            "    include_bytes!(concat!(env!(\"OUT_DIR\"), \"/{file}\")),"
+        )
+        .expect("write to a String");
+    }
+    index.push_str("];\n");
     std::fs::write(out.join("libs.rs"), index).expect("write the lib index");
 }
 
diff --git a/crates/ts_goport/src/frontend/bundled/embed.rs b/crates/ts_goport/src/frontend/bundled/embed.rs
index 875cc262..472cfca2 100644
--- a/crates/ts_goport/src/frontend/bundled/embed.rs
+++ b/crates/ts_goport/src/frontend/bundled/embed.rs
@@ -6,10 +6,9 @@
 //! lib texts come from `crates/ts_goport/libs`, a copy of the pinned
 //! `internal/bundled/libs` (see its PROVENANCE.md).
 //!
-//! PORT: the wasm build embeds the libs packed (one LZMA stream, 0.31 MB in
-//! place of 3.79 MB; see `parts/goport_util/build.rs`) and unpacks the
-//! stream up to each lib on its first read. The names and texts do not
-//! change.
+//! PORT: the wasm build embeds the libs packed (two LZMA streams in place of
+//! 3.79 MB; see `parts/goport_util/build.rs`) and unpacks a stream up to each
+//! lib on its first read. The names and texts do not change.
 
 #[cfg(not(target_family = "wasm"))]
 use super::{SNAPSHOT_TEXT_MIN, const_hash};
@@ -267,39 +266,59 @@ fn embedded_contents(rest: &str) -> Option<&'static str> {
 }
 
 // Go: embed_generated.go:238 embeddedContents
-// PORT: wasm unpacks the one stream of build.rs (`libs.lzma`, the libs in
-// `PACKED_LIBS` order) up to lib `rest`, and keeps each text it unpacks for
-// the life of the process. The reader stays too, with its 3.8 MB window
-// (one stream per lib needed at most 2.35 MB, for lib.dom.d.ts, at a time).
+// PORT: wasm unpacks the stream of lib `rest` (`PACKED_STREAMS`, from
+// build.rs; the libs of each stream in `PACKED_LIBS` order) up to that lib,
+// and keeps each text it unpacks for the life of the process. A stream's
+// reader stays while the stream has libs left, with its window: 1 MiB for
+// stream 0, 4 MiB for stream 1 (dom and webworker). A run that reads no
+// lib of stream 1 never makes its reader. When the last lib of a stream is
+// out, its reader drops, so the allocator can reuse the window.
 #[cfg(target_family = "wasm")]
 fn embedded_contents(rest: &str) -> Option<&'static str> {
     use std::io::Read;
     use std::sync::{Mutex, PoisonError};
+    /// One stream of `PACKED_STREAMS`: its reader, from the first read of
+    /// the stream until its last lib is out, and the texts it unpacked.
     struct Unpacked {
-        reader: lzma_rust2::LzmaReader<&'static [u8]>,
+        reader: Option<lzma_rust2::LzmaReader<&'static [u8]>>,
         texts: Vec<&'static str>,
     }
-    static UNPACKED: Mutex<Option<Unpacked>> = Mutex::new(None);
+    static UNPACKED: Mutex<Vec<Unpacked>> = Mutex::new(Vec::new());
     let index = packed_lib_index(rest)?;
+    let stream = PACKED_LIBS[index].2;
+    // The libs of `stream`, which are next to each other in `PACKED_LIBS`.
+    let first = PACKED_LIBS
+        .iter()
+        .position(|&(_, _, s)| s == stream)
+        .expect("lib `rest` is in its stream");
+    let count = PACKED_LIBS.iter().filter(|&&(_, _, s)| s == stream).count();
     let mut unpacked = UNPACKED.lock().unwrap_or_else(PoisonError::into_inner);
-    let unpacked = unpacked.get_or_insert_with(|| {
-        let packed: &'static [u8] = include_bytes!(concat!(env!("OUT_DIR"), "/libs.lzma"));
-        Unpacked {
-            reader: lzma_rust2::LzmaReader::new_mem_limit(packed, u32::MAX, None)
-                .expect("build.rs packs the libs"),
+    if unpacked.is_empty() {
+        unpacked.extend(PACKED_STREAMS.iter().map(|_| Unpacked {
+            reader: None,
             texts: Vec::new(),
-        }
-    });
-    while unpacked.texts.len() <= index {
-        let mut text = vec![0; PACKED_LIBS[unpacked.texts.len()].1];
+        }));
+    }
+    let unpacked = &mut unpacked[stream];
+    while unpacked.texts.len() <= index - first {
+        let mut text = vec![0; PACKED_LIBS[first + unpacked.texts.len()].1];
+        // The reader (and its window) is made on the first read of the
+        // stream. A stream whose libs are all out never reads again.
         unpacked
             .reader
+            .get_or_insert_with(|| {
+                lzma_rust2::LzmaReader::new_mem_limit(PACKED_STREAMS[stream], u32::MAX, None)
+                    .expect("build.rs packs the libs")
+            })
             .read_exact(&mut text)
             .expect("build.rs packs the libs");
         let text = String::from_utf8(text).expect("a lib is UTF-8");
         unpacked.texts.push(Box::leak(text.into_boxed_str()));
+        if unpacked.texts.len() == count {
+            unpacked.reader = None;
+        }
     }
-    Some(unpacked.texts[index])
+    Some(unpacked.texts[index - first])
 }
 
 /// The size of lib `rest` (`embedded_contents`) in bytes.
@@ -321,11 +340,12 @@ fn packed_lib_index(rest: &str) -> Option<usize> {
     if !EMBEDDED_CONTENTS.contains(&rest) {
         return None;
     }
-    let index = PACKED_LIBS.iter().position(|&(path, _)| path == rest);
+    let index = PACKED_LIBS.iter().position(|&(path, _, _)| path == rest);
     Some(index.expect("build.rs packs each bundled lib"))
 }
 
-// wasm: `PACKED_LIBS`, the path and size of each lib in `libs.lzma` order.
+// wasm: `PACKED_LIBS`, the path, size and stream of each lib in stream order,
+// and `PACKED_STREAMS`, the packed streams.
 #[cfg(target_family = "wasm")]
 include!(concat!(env!("OUT_DIR"), "/libs.rs"));
 
