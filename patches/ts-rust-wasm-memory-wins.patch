From bb16aaf43af58911c1e9d55cd26cbb5363917104 Mon Sep 17 00:00:00 2001
From: Gareth Andrew <gingerhendrix@gmail.com>
Date: Wed, 7 Oct 2026 16:34:51 +0100
Subject: [PATCH 1/3] wasm: set the shadow stack size with TS_WASM_STACK_SIZE

---
 crates/ts_wasm/build.rs | 27 ++++++++++++++++++++++++---
 scripts/wasm/build.sh   |  3 +++
 2 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/crates/ts_wasm/build.rs b/crates/ts_wasm/build.rs
index 345c091c..87d1418e 100644
--- a/crates/ts_wasm/build.rs
+++ b/crates/ts_wasm/build.rs
@@ -1,14 +1,35 @@
 //! Link settings of the wasm module. They are here, not in RUSTFLAGS, so
 //! every build of the module gets them (scripts/run-cargo-capped.sh sets
 //! RUSTFLAGS, which replaces target rustflags).
+//!
+//! env: TS_WASM_STACK_SIZE  the shadow stack in bytes (default 32 MiB)
+
+/// The default shadow stack: 32 MiB.
+const DEFAULT_STACK_SIZE: u64 = 32 << 20;
 
 fn main() {
+    println!("cargo:rerun-if-env-changed=TS_WASM_STACK_SIZE");
     if std::env::var("CARGO_CFG_TARGET_FAMILY").as_deref() == Ok("wasm") {
-        // The shadow stack in linear memory: 32 MiB. Native runs the
-        // checker on threads with 16 MiB to 1 GiB of stack
+        // The shadow stack in linear memory: 32 MiB by default. Native runs
+        // the checker on threads with 16 MiB to 1 GiB of stack
         // (gostd/stack.rs); the wasm shadow stack holds only the locals
         // whose address is taken, so it needs less. The stack is first in
         // memory, so an overflow traps and does not corrupt data.
-        println!("cargo:rustc-cdylib-link-arg=-zstack-size=33554432");
+        // Every instance pays for the whole stack. A host with a memory cap
+        // (a Cloudflare Worker) can set TS_WASM_STACK_SIZE=8388608 and save
+        // 24 MiB of each instance. With 8 MiB, `1 + 1 + ...` reached the
+        // same depth as with 32 MiB: about 1,700 terms in workerd, where
+        // V8's native stack overflows first, and 34,000 in npm/wasm
+        // node.js (a 256 MB worker stack). The default stays 32 MiB until
+        // a wider corpus shows that less is enough.
+        let size = std::env::var("TS_WASM_STACK_SIZE").map_or(DEFAULT_STACK_SIZE, |size| {
+            size.parse()
+                .expect("TS_WASM_STACK_SIZE is a number of bytes")
+        });
+        assert!(
+            size >= 1 << 20 && size % 16 == 0,
+            "TS_WASM_STACK_SIZE is at least 1 MiB and a multiple of 16"
+        );
+        println!("cargo:rustc-cdylib-link-arg=-zstack-size={size}");
     }
 }
diff --git a/scripts/wasm/build.sh b/scripts/wasm/build.sh
index f3cf7227..c6c9ec7e 100755
--- a/scripts/wasm/build.sh
+++ b/scripts/wasm/build.sh
@@ -8,6 +8,9 @@
 #        WASM_RUSTFLAGS  added to RUSTFLAGS (default none)
 #        WASM_OPT        wasm-opt flags (default "--flatten --rereloop -Oz -Oz");
 #                        "none" skips wasm-opt and the function order
+#        TS_WASM_STACK_SIZE  the shadow stack in bytes (default 33554432, 32 MiB;
+#                        crates/ts_wasm/build.rs). 8388608 saves 24 MiB of each
+#                        instance where the engine stack is small (Workers, browsers)
 # needs: rustup target add wasm32-wasip1; wasm-opt (binaryen 132 or later);
 #        node
 #
-- 
